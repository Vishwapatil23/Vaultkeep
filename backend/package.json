{
  "name": "vaultkeep-backend",
  "version": "1.0.0",
  "description": "VaultKeep: Cloud-Based Encrypted Digital Legacy & Nominee Access System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
