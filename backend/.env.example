# VaultKeep Backend Environment Configuration
# Node & Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets
JWT_SECRET=vaultkeep_jwt_super_secure_dev_secret_key_2026_x89a
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Database Configuration (Amazon RDS PostgreSQL Live Database)
DB_HOST=vaultkeep-postgresql-db.cyrw6icwadyc.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=vaultkeep_db
DB_USER=vaultkeep_admin
DB_PASSWORD=VaultKeepSecureDevPassword2026!
DB_SSL=true
USE_IN_MEMORY_DB=false

# AWS Cloud Services Configuration
AWS_REGION=us-east-1
# S3 Bucket for Private Encrypted Document Storage
S3_BUCKET_NAME=vaultkeep-documents-327973843616-us-east-1
# AWS KMS Customer Managed Key ARN or Alias
KMS_KEY_ID=alias/vaultkeep-master-key
# Amazon SNS Topic ARN for Nominee and Inactivity Notifications
SNS_INACTIVITY_TOPIC_ARN=arn:aws:sns:us-east-1:327973843616:vaultkeep-inactivity-alerts
SNS_ACCESS_GRANTED_TOPIC_ARN=arn:aws:sns:us-east-1:327973843616:vaultkeep-access-granted
# Systems Manager Parameter Store Prefix
SSM_PARAM_PREFIX=/vaultkeep/prod/
# CloudWatch Metric Namespace
CLOUDWATCH_NAMESPACE=VaultKeep/Application

# Operational / Inactivity Defaults
DEFAULT_CHECK_IN_INTERVAL_DAYS=30
DEFAULT_GRACE_PERIOD_DAYS=7
DEFAULT_WARNING_DAYS=5

# Set to false to use live AWS SNS, KMS, and S3
AWS_MOCK_SERVICES=false
