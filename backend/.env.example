# ==============================================================================
# VaultKeep Backend Environment Configuration Template (.env.example)
# Copy this file to .env and configure with your environment values.
# Sensitive production credentials should be managed via AWS Systems Manager
# Parameter Store or AWS Secrets Manager.
# ==============================================================================

# Node & Server
PORT=5000
NODE_ENV=production
API_PREFIX=/api
CORS_ORIGIN=https://your-domain.example.com

# Authentication Secrets
JWT_SECRET=generate_a_secure_random_jwt_secret_minimum_32_chars
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Database Configuration (Amazon RDS PostgreSQL Live Database)
DB_HOST=your-rds-postgresql-cluster.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=vaultkeep_db
DB_USER=vaultkeep_admin
DB_PASSWORD=your_secure_rds_password_or_ssm_reference
DB_SSL=true
DB_CA_PATH=certs/rds-ca-bundle.pem
USE_IN_MEMORY_DB=false

# AWS Cloud Services Configuration
AWS_REGION=us-east-1
# S3 Bucket for Private Encrypted Document Storage
S3_BUCKET_NAME=your-vaultkeep-encrypted-documents-bucket
# AWS KMS Customer Managed Key ARN or Alias
KMS_KEY_ID=alias/vaultkeep-master-key
# Amazon SNS Topic ARNs for Nominee and Inactivity Notifications
SNS_INACTIVITY_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:vaultkeep-inactivity-alerts
SNS_ACCESS_GRANTED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:vaultkeep-access-granted
# Systems Manager Parameter Store Prefix
SSM_PARAM_PREFIX=/vaultkeep/prod/
# CloudWatch Metric Namespace
CLOUDWATCH_NAMESPACE=VaultKeep/Application

# Operational / Inactivity Defaults
DEFAULT_CHECK_IN_INTERVAL_DAYS=30
DEFAULT_GRACE_PERIOD_DAYS=7
DEFAULT_WARNING_DAYS=5

# Set to true only for offline local unit tests without AWS credentials
AWS_MOCK_SERVICES=false
