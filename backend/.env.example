# VaultKeep Backend Environment Configuration
# Node & Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets
JWT_SECRET=vaultkeep_jwt_super_secure_dev_secret_key_2026_x89a
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Database Configuration (PostgreSQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vaultkeep_db
DB_USER=vaultkeep_user
DB_PASSWORD=vaultkeep_secure_dev_password
DB_SSL=false
# If using embedded/in-memory fallback when PostgreSQL is not running:
USE_IN_MEMORY_DB=true

# AWS Cloud Services Configuration
AWS_REGION=us-east-1
# S3 Bucket for Private Encrypted Document Storage
S3_BUCKET_NAME=vaultkeep-encrypted-documents-dev
# AWS KMS Customer Managed Key ARN or Alias
KMS_KEY_ID=alias/vaultkeep-master-key
# Amazon SNS Topic ARN for Nominee and Inactivity Notifications
SNS_INACTIVITY_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:vaultkeep-inactivity-alerts
SNS_ACCESS_GRANTED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:vaultkeep-access-granted
# Systems Manager Parameter Store Prefix
SSM_PARAM_PREFIX=/vaultkeep/prod/
# CloudWatch Metric Namespace
CLOUDWATCH_NAMESPACE=VaultKeep/Application

# Operational / Inactivity Defaults
DEFAULT_CHECK_IN_INTERVAL_DAYS=90
DEFAULT_GRACE_PERIOD_DAYS=7
DEFAULT_WARNING_DAYS=5

# Set to true to use local KMS & S3 simulator when running locally without AWS credentials
AWS_MOCK_SERVICES=true
